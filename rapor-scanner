#!/bin/bash
#
# Rapor Scanner CLI Tool
# Usage: rapor-scanner [command]
#

APP_DIR="/opt/rapor-scanner"
SERVICE_NAME="rapor-scanner"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

show_status() {
    echo ""
    echo -e "${BLUE}╔═══════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║      📊 Rapor Scanner Status                       ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════╝${NC}"
    echo ""
    
    if systemctl is-active --quiet $SERVICE_NAME; then
        echo -e "   Status:  ${GREEN}● Running${NC}"
    else
        echo -e "   Status:  ${RED}● Stopped${NC}"
    fi
    
    IP=$(hostname -I | awk '{print $1}')
    echo -e "   URL:     ${GREEN}http://$IP:8501${NC}"
    echo -e "   Dir:     $APP_DIR"
    echo ""
}

show_help() {
    echo ""
    echo -e "${BLUE}📊 Rapor Scanner CLI${NC}"
    echo ""
    echo "Usage: rapor-scanner [command]"
    echo ""
    echo "Commands:"
    echo "  status    - Show service status"
    echo "  start     - Start service"
    echo "  stop      - Stop service"
    echo "  restart   - Restart service"
    echo "  logs      - View live logs"
    echo "  update    - Update from GitHub"
    echo "  help      - Show this help"
    echo ""
}

do_update() {
    echo -e "${YELLOW}📥 Updating Rapor Scanner...${NC}"
    cd $APP_DIR
    
    echo -e "${BLUE}   Pulling from GitHub...${NC}"
    git pull origin main
    
    echo -e "${BLUE}   Installing dependencies...${NC}"
    source venv/bin/activate
    pip install -r requirements.txt -q
    
    echo -e "${BLUE}   Restarting service...${NC}"
    systemctl restart $SERVICE_NAME
    
    echo -e "${GREEN}✅ Update complete!${NC}"
    show_status
}

case "$1" in
    status)
        show_status
        ;;
    start)
        echo -e "${YELLOW}Starting $SERVICE_NAME...${NC}"
        systemctl start $SERVICE_NAME
        show_status
        ;;
    stop)
        echo -e "${YELLOW}Stopping $SERVICE_NAME...${NC}"
        systemctl stop $SERVICE_NAME
        show_status
        ;;
    restart)
        echo -e "${YELLOW}Restarting $SERVICE_NAME...${NC}"
        systemctl restart $SERVICE_NAME
        show_status
        ;;
    logs)
        journalctl -u $SERVICE_NAME -f
        ;;
    update)
        do_update
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        show_status
        show_help
        ;;
esac
